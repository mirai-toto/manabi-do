-- Single source of truth for the database schema.
--
-- drift generates the Dart table classes from this file, and
-- pipeline/build_content_db.py in mirai-toto/manabi-content executes the same statements when building the
-- shipped content DB. Keep it to plain CREATE TABLE so both readers cope.
--
-- Changing anything here is a schema change: bump `schemaVersion` in
-- app_database.dart and add a migration step. `flutter test test/schema_test.dart`
-- asserts that this file and drift agree.

CREATE TABLE kanjis (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character TEXT NOT NULL,
  meaning TEXT NOT NULL,
  on_reading TEXT NOT NULL,
  kun_reading TEXT NOT NULL,
  jlpt_level TEXT NOT NULL,
  svg TEXT,
  -- Measured difficulty from KANJIDIC2, downloaded since the start and
  -- discarded until now. `grade` is the school year a kanji is taught in,
  -- `freq` its rank in a newspaper corpus. Both null for a kanji KANJIDIC2
  -- does not rank.
  grade INTEGER,
  freq INTEGER
);

CREATE TABLE kanas (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  character TEXT NOT NULL,
  romaji TEXT NOT NULL,
  type TEXT NOT NULL,
  "row" TEXT NOT NULL,
  kana_group TEXT NOT NULL,
  slot INTEGER NOT NULL
);

CREATE TABLE vocabulary_entries (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  word TEXT NOT NULL,
  reading TEXT NOT NULL,
  meaning TEXT NOT NULL,
  part_of_speech TEXT NOT NULL,
  -- JMdict's newspaper frequency band, 1 (most common) to 48, or 49 for a word
  -- on another of its common lists with no band. Null means no evidence.
  freq_band INTEGER,
  -- Computed difficulty, 0 (easiest) to 1000, with the tier it falls in and
  -- what fed the number.
  --
  -- There is no `jlpt_level` here, unlike `kanjis`. The JLPT publishes a kanji
  -- list and no vocabulary list, so a word's "level" in any dataset is a guess
  -- by whoever built it. The column used to hold such a guess, and after the
  -- score arrived it held the tier wearing JLPT names, which was worse: the
  -- label claimed an exam that had never been consulted.
  difficulty INTEGER NOT NULL DEFAULT 0,
  difficulty_source TEXT NOT NULL DEFAULT '',
  -- Which vocabulary level the word sits in, 1 (commonest) to 5, and which
  -- group of thirty inside that level. Together they are the study order: the
  -- app teaches level 1 group 1 first, and those thirty words are over a fifth
  -- of running Japanese on their own.
  --
  -- Named `vocabulary_level` and not `level` so it cannot be read as the exam
  -- level that `kanjis.jlpt_level` holds. It is measured, not assigned: a level
  -- is a span of the frequency order, so "level 1" means "this far into the
  -- language". It replaced a `difficulty_tier` that banded words by share of
  -- our own word list, which was a fact about the app rather than about
  -- Japanese.
  vocabulary_level INTEGER NOT NULL DEFAULT 5,
  group_index INTEGER NOT NULL DEFAULT 1
);

-- What each study group buys, as a share of running Japanese, measured on the
-- BCCWJ corpus. Summing the groups a learner has finished is how the app knows
-- what they can read.
--
-- Per group of thirty words rather than per word, and that is deliberate.
-- BCCWJ is free for research and education and handled case by case otherwise,
-- so no per-word count or rank leaves the build machine. A share of thirty
-- words together cannot be turned back into one.
--
-- `corpus_share` is 0 for the groups in level 5, whose words the corpus cannot
-- attribute: UniDic splits お願いします into pieces and counts お菓子 as お plus
-- 菓子. That is a missing measurement, not a claim that the words are rare, and
-- it is why the app says "at least" when it adds these numbers up.
CREATE TABLE coverage_groups (
  vocabulary_level INTEGER NOT NULL,
  group_index INTEGER NOT NULL,
  word_count INTEGER NOT NULL,
  corpus_share REAL NOT NULL,
  PRIMARY KEY (vocabulary_level, group_index)
);

-- Which kanji a word is written with. A word has as many as it has: this
-- replaced a single `vocabulary_entries.kanji_id`, which held the first one
-- and discarded the rest, so 今日 knew about 今 and not 日. Scoring a word by
-- the school grade of its kanji is impossible while a word knows only one.
--
-- `position` is where the kanji first appears in the word, so the order a
-- reader sees is preserved. A kanji repeated in one word gets a single row.
CREATE TABLE vocabulary_kanji (
  vocabulary_id INTEGER NOT NULL REFERENCES vocabulary_entries (id),
  kanji_id INTEGER NOT NULL REFERENCES kanjis (id),
  position INTEGER NOT NULL,
  PRIMARY KEY (vocabulary_id, kanji_id)
);

CREATE TABLE kanji_translations (
  kanji_id INTEGER NOT NULL REFERENCES kanjis (id),
  locale TEXT NOT NULL,
  meaning TEXT NOT NULL,
  PRIMARY KEY (kanji_id, locale)
);

CREATE TABLE vocabulary_translations (
  vocabulary_id INTEGER NOT NULL REFERENCES vocabulary_entries (id),
  locale TEXT NOT NULL,
  meaning TEXT NOT NULL,
  PRIMARY KEY (vocabulary_id, locale)
);

CREATE TABLE sentences (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  japanese TEXT NOT NULL,
  target_word TEXT NOT NULL,
  vocabulary_id INTEGER NOT NULL REFERENCES vocabulary_entries (id),
  furigana_before TEXT,
  furigana_after TEXT,
  furigana TEXT
);

CREATE TABLE sentence_translations (
  sentence_id INTEGER NOT NULL REFERENCES sentences (id),
  locale TEXT NOT NULL,
  translation TEXT NOT NULL,
  PRIMARY KEY (sentence_id, locale)
);

CREATE TABLE exercises (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  locale TEXT NOT NULL,
  type TEXT NOT NULL,
  source TEXT NOT NULL,
  source_id INTEGER NOT NULL,
  prompt TEXT NOT NULL,
  answer TEXT NOT NULL,
  distractors TEXT NOT NULL DEFAULT '[]'
);

CREATE TABLE grammar_lessons (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  locale TEXT NOT NULL DEFAULT 'en',
  level TEXT NOT NULL,
  path TEXT NOT NULL,
  theme_name TEXT NOT NULL DEFAULT '',
  theme_description TEXT NOT NULL DEFAULT '',
  chapter TEXT NOT NULL,
  title TEXT NOT NULL,
  blocks_json TEXT NOT NULL,
  order_index INTEGER NOT NULL,
  difficulty INTEGER NOT NULL DEFAULT 1
) AS GrammarLessonRow;

CREATE TABLE grammar_exercises (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  lesson_path TEXT NOT NULL,
  order_index INTEGER NOT NULL,
  type TEXT NOT NULL,
  data_json TEXT NOT NULL
) AS GrammarExerciseRow;

CREATE TABLE grammar_lesson_progress (
  lesson_path TEXT NOT NULL,
  read_at DATETIME NOT NULL,
  PRIMARY KEY (lesson_path)
) AS GrammarLessonProgressRow;

CREATE TABLE grammar_lesson_starts (
  lesson_path TEXT NOT NULL,
  PRIMARY KEY (lesson_path)
) AS GrammarLessonStartRow;

CREATE TABLE grammar_chapter_unlocks (
  chapter_key TEXT NOT NULL,
  PRIMARY KEY (chapter_key)
) AS GrammarChapterUnlockRow;

CREATE TABLE progress_entries (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  item_type TEXT NOT NULL,
  item_id INTEGER NOT NULL,
  is_known BOOLEAN NOT NULL CHECK (is_known IN (0, 1)),
  toggled_at DATETIME NOT NULL,
  UNIQUE (item_type, item_id)
);

CREATE TABLE srs_cards (
  item_type TEXT NOT NULL,
  item_id INTEGER NOT NULL,
  due DATETIME NOT NULL,
  first_seen_at DATETIME,
  card_json TEXT NOT NULL,
  PRIMARY KEY (item_type, item_id)
);
