{
  "id": "counters",
  "title": "Counters",
  "blocks": [
    {
      "type": "text",
      "content": "Japanese does not use bare numbers to count objects. Numbers pair with **counters** : suffixes that classify what is being counted. The number reading also changes depending on which counter follows."
    },
    {
      "type": "pattern",
      "lines": [
        "[Number] + **[Counter]**"
      ]
    },
