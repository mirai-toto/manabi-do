{
  "id": "polite-present",
  "title": "Polite Present : ます",
  "blocks": [
    {
      "type": "text",
      "content": "The **ます form** is how you speak politely. It is the default for conversations with people you do not know well, in formal situations, and in service environments. It covers both present habit and future intention : Japanese does not separate these two ideas."
    },
    {
      "type": "section_title",
      "content": "Formation"
    },
    {
      "type": "transform_cards",
      "groups": [
        {
          "label": "Group 1",
          "tag": "Godan",
          "rule": "change the final u-vowel to i-vowel, then add ます",
          "rows": [
            {
              "base": "書く",
              "old": "く",
              "new": "きます",
              "result": "書きます",
              "romaji": "kakimasu",
              "english": "to write"
            },
            {
              "base": "話す",
              "old": "す",
              "new": "します",
              "result": "話します",
              "romaji": "hanashimasu",
              "english": "to speak"
            },
            {
              "base": "待つ",
              "old": "つ",
              "new": "ちます",
              "result": "待ちます",
              "romaji": "machimasu",
              "english": "to wait"
            },
            {
              "base": "飲む",
              "old": "む",
              "new": "みます",
              "result": "飲みます",
              "romaji": "nomimasu",
              "english": "to drink"
            },
            {
              "base": "帰る",
              "old": "る",
              "new": "ります",
              "result": "帰ります",
              "romaji": "kaerimasu",
              "english": "to return home"
            }
          ],
          "note": "Negative: replace ます with ません : the stem stays the same",
          "description": "The most common group : the majority of Japanese verbs fall here."
        },
        {
          "label": "Group 2",
          "tag": "Ichidan",
          "rule": "remove る, add ます directly to the stem",
          "rows": [
            {
              "base": "食べる",
              "old": "る",
              "new": "ます",
              "result": "食べます",
              "romaji": "tabemasu",
              "english": "to eat"
            },
            {
              "base": "見る",
              "old": "る",
              "new": "ます",
              "result": "見ます",
              "romaji": "mimasu",
              "english": "to see"
            },
            {
              "base": "起きる",
              "old": "る",
              "new": "ます",
              "result": "起きます",
              "romaji": "okimasu",
              "english": "to wake up"
            }
          ],
          "description": "Fewer verbs, but much simpler to conjugate."
        },
        {
          "label": "Group 3",
          "tag": "Irregular",
          "rows": [
            {
              "base": "する",
              "result": "します",
              "romaji": "shimasu",
              "english": "to do"
            },
            {
              "base": "来る",
              "result": "来ます",
              "romaji": "kimasu",
              "english": "to come"
            }
          ],
          "description": "Only two verbs in Japanese are truly irregular : memorise them as-is."
        }
      ]
    },
    {
      "type": "example_table",
      "columns": [
        "japanese",
        "romaji",
        "english"
      ],
      "rows": [
        {
          "japanese": "毎朝コーヒーを飲みます。",
          "romaji": "Maiasa koohii wo nomimasu.",
          "english": "I drink coffee every morning."
        },
        {
          "japanese": "明日、友達に会います。",
          "romaji": "Ashita, tomodachi ni aimasu.",
          "english": "I'll meet a friend tomorrow."
        },
        {
          "japanese": "肉を食べません。",
          "romaji": "Niku wo tabemasen.",
          "english": "I don't eat meat."
        },
        {
          "japanese": "日本語を勉強します。",
          "romaji": "Nihongo wo benkyō shimasu.",
          "english": "I study Japanese."
        }
      ]
    },
    {
      "type": "note",
      "content": "ます covers both habits and planned future actions. Context makes the meaning clear : Japanese has no separate future tense."
    },
    {
      "type": "note",
      "content": "ます is polite but not formal. Use it with a shop clerk, a new acquaintance, or a teacher. Among close friends, speakers drop to the plain (dictionary) form. Both are grammatically correct : register determines which fits."
    }
  ]
}