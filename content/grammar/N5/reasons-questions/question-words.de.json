        },
        {
          "japanese": "どちら / どっち",
          "romaji": "dochira / docchi",
          "deutsch": "welches (von zweien) / in welche Richtung"
        },
        {
          "japanese": "いくら",
          "romaji": "ikura",
          "deutsch": "wie viel (Preis)"
        }
