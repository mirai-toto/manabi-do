      ],
      "rows": [
        {
          "japanese": "何 (なに / なん)",
          "romaji": "nani / nan",
          "deutsch": "was"
        },
        {
          "japanese": "誰",
          "romaji": "dare",
          "deutsch": "wer"
        },
        {
          "japanese": "どこ",
          "romaji": "doko",
          "deutsch": "wo"
        },
        {
          "japanese": "いつ",
          "romaji": "itsu",
          "deutsch": "wann"
        },
        {
          "japanese": "どう",
          "romaji": "dō",
          "deutsch": "wie (auf welche Weise)"
        },
        {
          "japanese": "なぜ",
          "romaji": "naze",
          "deutsch": "warum (förmlich / schriftlich)"
        },
