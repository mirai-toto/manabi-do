# Local audit/planning notes
WIDGET_AUDIT.md
DIMENS_AUDIT.md

# Generated design reference (rebuild: dart run tool/gen_design_reference.dart)
/design-reference/

# Raw source data — large downloads. Only the content pipeline produced these,
# and it now lives in mirai-toto/manabi-content.
/data/

# The content database is built in mirai-toto/manabi-content and published as a
# release asset. scripts/content/fetch_content.sh downloads the version pinned
# in manabi_do/content.lock. Tracking it put 91 MB of generated output in git.
/manabi_do/assets/manabi_do_content.db

# dart2js leftovers beside the drift web worker. The worker itself is loaded at
# runtime and has to ship; these two do not. The .deps file is a dependency
# manifest full of absolute paths from whichever machine compiled it.
/manabi_do/web/drift_worker.js.deps
/manabi_do/web/drift_worker.js.map

# Dev-mode live DB (stored at repo root when running flutter run -d linux)
manabi_do.db
manabi_do.db-shm
manabi_do.db-wal
manabi_do.db.version
manabi_do.sqlite

# SQLite journals — recreated on demand by whatever opens a DB, never content
*.db-shm
*.db-wal

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
.claude/settings.local.json
*.iml
*.iws
*.ipr

# Docker
docker-compose.override.yml

# Screenshots — local only
scripts/screenshot/output/

# SonarQube — generated/downloaded, not committed
scripts/sonar/plugins/
scripts/sonar/.sonar_token
manabi_do/analysis-results.txt
manabi_do/tests.output
manabi_do/coverage/

# Playwright install (auto-installed by scripts/screenshot/rebuild_and_screenshot.sh)
scripts/screenshot/pw/
node_modules/

# Python bytecode from scripts/
__pycache__/
*.pyc
